# Copy to .env (or just export these) — every one is optional.

# NOAA asks API clients to identify themselves. Put a real contact in here;
# an anonymous or spoofed agent can get you rate-limited or blocked.
NWS_USER_AGENT="TexasWeatherCheddar/1.0 (you@example.com)"

# auto      live NOAA, falling back to the synthetic model if NOAA is unreachable
# nws       live NOAA only; never simulated (holds the last good frame if it fails)
# synthetic rehearsal mode — always the model, always badged SIMULATED
WEATHER_SOURCE=auto

PORT=8080
HOST=0.0.0.0

# Polling. Surface observations only refresh every 20-60 minutes upstream and
# the radar mosaic every ~5, so there is nothing to gain by going faster.
OBS_INTERVAL_MS=150000
RADAR_INTERVAL_MS=120000

# Set to 0 to skip the NEXRAD mosaic and derive precipitation from station
# present-weather reports alone.
RADAR_ENABLED=1

# How many stations to poll (thinned across a grid so coverage stays even).
STATION_CAP=48

# Largest single upload accepted, in megabytes.
MAX_UPLOAD_MB=256

# Only override these to point at a mirror or a mock.
# NWS_BASE=https://api.weather.gov
# RADAR_WMS=https://mesonet.agron.iastate.edu/cgi-bin/wms/nexrad/n0q.cgi
# FFMPEG_PATH=ffmpeg
